index 1111111..2222222 100644
--- a/src/pipeline-ui.js
+++ b/src/pipeline-ui.js
@@
 const state = {

  images: { tt: [], col: [] },

  outputs: {},

  inputs: {},

  persistentRules: {},

  promptsByMode: { tabletop: {}, collection: {} },

  bibliosByMode: { tabletop: {}, collection: {} },

  selectedAccroche: null,

  selectedCTA: null,

  selectedTitre: null,

  orchestrateurActif: false,

  orchAttempts: {},

  socialSections: {},

  _lastOrchProblems: {},
  sessionCost: 0,

  mode: 'tabletop',

  agentUsage: {},

 };
+
+let microUxObserver = null;
+
+function normalizeMicroUxText(text = '') {
+
+ return text.replace(/\s+/g, ' ').trim();
+
+}
+
+function getButtonMicroUxMeta(btn) {
+
+ const onclick = btn.getAttribute('onclick') || '';
+
+ const text = normalizeMicroUxText(btn.textContent || '');
+
+ if (onclick.includes('validateTag(') || onclick.includes('validateTitreSegment(')) {
+
+  return { label: 'Valider cet élément', icon: '✓', action: 'validate', iconOnly: true };
+
+ }
+
+ if (onclick.includes('invalidateTag(') || onclick.includes('invalidateTitreSegment(')) {
+
+  return { label: 'Invalider ou blacklister cet élément', icon: '✕', action: 'invalidate', iconOnly: true };
+
+ }
+
+ if (onclick.includes('rerollTag(')) {
+
+  return { label: 'Régénérer une alternative', icon: '↻', action: 'reroll', iconOnly: true };
+
+ }
+
+ if (onclick.includes('copyTitreLine(')) {
+
+  return { label: 'Copier cette ligne', icon: '⧉', action: 'copy', iconOnly: true };
+
+ }
+
+ if (onclick.includes('copyOut(')) {
+
+  return { label: 'Copier la sortie de cet agent', icon: '⧉', action: 'copy', iconOnly: true };
+
+ }
+
+ if (onclick.includes('pasteSelectedTitre(')) {
+
+  return { label: 'Coller le titre sélectionné', icon: '↙', action: 'paste', iconOnly: true };
+
+ }
+
+ if (onclick.includes('showRawInput(')) {
+
+  return { label: 'Afficher l’entrée brute envoyée à l’agent', iconOnly: true };
+
+ }
+
+ if (onclick.includes('openPromptLightbox(')) {
+
+  return { label: 'Éditer le prompt de cet agent', iconOnly: true };
+
+ }
+
+ if (onclick.includes('rerunSuite(')) {
+
+  return { label: 'Relancer cet agent puis exécuter la suite' };
+
+ }
+
+ if (onclick.includes('persistRule(')) {
+
+  return { label: 'Transformer cette correction en règle permanente' };
+
+ }
+
+ if (onclick.includes('rerunAgent(')) {
+
+  return { label: 'Relancer uniquement cet agent' };
+
+ }
+
+ if (onclick.includes('stopAgent(')) {
+
+  return { label: 'Arrêter cet agent en cours' };
+
+ }
+
+ if (onclick.includes('runTagExplorer(')) {
+
+  return { label: 'Explorer plus de propositions de tags' };
+
+ }
+
+ if (onclick.includes('runTitreExplorer(')) {
+
+  return { label: 'Explorer plus de propositions de titres' };
+
+ }
+
+ if (text) return { label: text };
+
+ return null;
+
+}
+
+function enhanceButtonMicroUx(btn) {
+
+ if (!btn || btn.dataset.microUxReady === '1') return;
+
+ const meta = getButtonMicroUxMeta(btn);
+
+ if (!meta) return;
+
+ if (meta.icon && !normalizeMicroUxText(btn.textContent || '')) {
+
+  btn.textContent = meta.icon;
+
+ }
+
+ if (meta.action) {
+
+  btn.dataset.action = meta.action;
+
+ }
+
+ if (meta.label) {
+
+  if (!btn.getAttribute('title')) btn.setAttribute('title', meta.label);
+
+  if (!btn.getAttribute('aria-label')) btn.setAttribute('aria-label', meta.label);
+
+  const isCompact = meta.iconOnly || normalizeMicroUxText(btn.textContent || '').length <= 3 || btn.classList.contains('titre-thumb') || btn.classList.contains('titre-copy');
+
+  if (isCompact) {
+
+   btn.dataset.tooltip = meta.label;
+
+  }
+
+ }
+
+ if ((meta.iconOnly || normalizeMicroUxText(btn.textContent || '').length <= 3) && btn.classList.contains('btn')) {
+
+  btn.classList.add('btn-icon-only');
+
+ }
+
+ btn.dataset.microUxReady = '1';
+
+}
+
+function getFieldMicroUxLabel(field) {
+
+ const placeholder = normalizeMicroUxText(field.getAttribute('placeholder') || '');
+
+ const host = field.closest('.fg, .correction-area, .apikey-row, .settings-section');
+
+ const label = normalizeMicroUxText(host?.querySelector('label, .settings-label')?.textContent || '');
+
+ return label || placeholder || '';
+
+}
+
+function enhanceMicroInteractions(root = document) {
+
+ const scope = root && typeof root.querySelectorAll === 'function' ? root : document;
+
+ scope.querySelectorAll('button').forEach(enhanceButtonMicroUx);
+
+ scope.querySelectorAll('.fg input, .fg select, .fg textarea, .manual-titre-row input, .correction-area textarea, .apikey-row input, .settings-input').forEach(field => {
+
+  const label = getFieldMicroUxLabel(field);
+
+  if (!label) return;
+
+  if (!field.getAttribute('title')) field.setAttribute('title', label);
+
+  if (!field.getAttribute('aria-label')) field.setAttribute('aria-label', label);
+
+ });
+
+}
+
+function initMicroInteractionLayer() {
+
+ if (!document.body) return;
+
+ enhanceMicroInteractions(document);
+
+ if (microUxObserver) return;
+
+ microUxObserver = new MutationObserver((mutations) => {
+
+  for (const mutation of mutations) {
+
+   mutation.addedNodes.forEach((node) => {
+
+    if (node.nodeType === 1) enhanceMicroInteractions(node);
+
+   });
+
+  }
+
+ });
+
+ microUxObserver.observe(document.body, { childList: true, subtree: true });
+
+}
+
+if (document.readyState === 'loading') {
+
+ document.addEventListener('DOMContentLoaded', initMicroInteractionLayer, { once: true });
+
+} else {
+
+ initMicroInteractionLayer();
+
+}

