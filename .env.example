# Pinterest API v5 — POC Sandbox
# URL à enregistrer dans le dashboard Pinterest :
# https://localhost:8443/pinterest/oauth/callback
PINTEREST_API_ENV=sandbox
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REDIRECT_URI=https://localhost:8443/pinterest/oauth/callback
# Option rapide pour le jeton généré depuis le dashboard Sandbox.
# Laisser vide si la connexion OAuth intégrée est utilisée.
PINTEREST_ACCESS_TOKEN=
