+async function confirmLibraryBlacklistModal() {
+  const s = window.__libraryBlacklistState;
+  if (!s) return;
+
+  const rawEntries = parseBulkLibraryEntries(document.getElementById('libraryBlacklistTextarea')?.value || '');
+  const entries = rawEntries.length ? rawEntries : (s.currentValue ? [s.currentValue] : []);
+  if (!entries.length) {
+    closeLibraryBlacklistModal();
+    return;
+  }
+
+  try {
+    if (s.kind === 'tags') {
+      const { validated, blacklisted } = parseBiblioTags(getBiblio('tags'));
+      const added = [];
+      for (const entry of entries.map(x => x.trim()).filter(Boolean)) {
+        if (blacklisted.includes(entry)) continue;
+        blacklisted.push(entry);
+        added.push(entry);
+      }
+      if (added.length) await saveTagsLibrary(validated, blacklisted);
+      if (s.itemId) {
+        const el = document.getElementById(s.itemId);
+        if (el) setTimeout(() => autoRegenTag(s.currentValue, added[0] || s.currentValue, el), 0);
+      }
+      showToast(added.length ? `👎 ${added.length} tag(s) blacklisté(s)` : 'Déjà blacklisté', added.length ? '#ff8c42' : '#7eb8f7');
+    } else {
+      const { validated, blacklisted } = parseBiblioTitres(getBiblio('titres'));
+      const added = [];
+      for (const entry of entries.map(x => x.trim()).filter(Boolean)) {
+        if (blacklisted.includes(entry)) continue;
+        blacklisted.push(entry);
+        added.push(entry);
+      }
+      if (added.length) await saveTitresLibrary(validated, blacklisted);
+      if (s.itemId) {
+        const el = document.getElementById(s.itemId);
+        if (el) setTimeout(() => autoRegenTitre(s.currentValue, added[0] || s.currentValue, el, s.agentId || 'titre'), 0);
+      }
+      showToast(added.length ? `👎 ${added.length} titre(s) blacklisté(s)` : 'Déjà blacklisté', added.length ? '#ff8c42' : '#7eb8f7');
+    }
+    closeLibraryBlacklistModal();
+  } catch (e) {
+    setLibraryModalFeedback('blacklist', 'Erreur de sauvegarde', 'error');
+  }
+}
