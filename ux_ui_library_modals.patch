+  try {
+    if (s.kind === 'tags') {
+      const { validated, blacklisted } = parseBiblioTags(getBiblio('tags'));
+      const next = [...validated];
+      let added = 0;
+      for (const entry of entries.map(x => x.trim()).filter(Boolean)) {
+        if (next.includes(entry)) continue;
+        next.push(entry);
+        added++;
+      }
+      if (added) await saveTagsLibrary(next, blacklisted);
+      showToast(added ? `✅ ${added} tag(s) validé(s) ajouté(s)` : 'Aucun nouveau tag ajouté', added ? '#2ecc71' : '#7eb8f7');
+    } else {
+      const { validated, blacklisted } = parseBiblioTitres(getBiblio('titres'));
+      const next = [...validated];
+      let added = 0;
+      for (const entry of entries.map(x => x.trim()).filter(Boolean)) {
+        if (next.includes(entry)) continue;
+        next.push(entry);
+        added++;
+      }
+      if (added) await saveTitresLibrary(next, blacklisted);
+      showToast(added ? `✅ ${added} titre(s) validé(s) ajouté(s)` : 'Aucun nouveau titre ajouté', added ? '#2ecc71' : '#7eb8f7');
+    }
+    closeLibraryValidatedModal();
+  } catch (e) {
+    setLibraryModalFeedback('validated', 'Erreur de sauvegarde', 'error');
+  }
