const CACHE_FIXED = {
  marche:      () => `CONTEXTE GLOBAL:\n${getBiblio('objectif')}\n\nPSYCHOLOGIE CLIENT:\n${getBiblio('psycho')}`,
  titre:       () => `BIBLIOTHÈQUE TITRES:\n${getBiblio('titres')}`,
