// ═══════════════════════════════════════════════════════════
function parseChoices(output, prefix) {
  const lines = output.split('\n').map(l => l.trim()).filter(Boolean);
  const choices = [];
  for (const l of lines) {
    const m = l.match(new RegExp(`^${prefix}(\\d+)\\s*[→:]\\s*(.+)`));
    if (m) choices.push({ num: m[1], text: m[2].trim() });
  }
  if (choices.length > 0) return choices;
  if (prefix === 'A') {
    let pastTechnique = false;
    for (const l of lines) {
      if (l.startsWith('•') || l.startsWith('🛠️')) { pastTechnique = true; continue; }
      if (!pastTechnique) continue;
      const hasEmoji = /^[\u{1F300}-\u{1FFFF}⚡🎯⚔️🎨🏆💫🎁🔥✨🏅💎🌑👀⏳🎲🖌️🎭]/u.test(l);
      if (hasEmoji && choices.length < 5) choices.push({ num: String(choices.length + 1), text: l });
      if (l.includes('Conseils de peinture')) break;
    }
  }
  if (prefix === 'C') {
    let pastConseils = false, count = 0;
    for (const l of lines) {
      if (l.includes('Conseils de peinture') || l.startsWith('🎨 Conseils')) { pastConseils = true; continue; }
      if (!pastConseils) continue;
      if (l.startsWith('🎭') || l.includes('Fan Art')) break;
      const hasEmoji = /^[\u{1F300}-\u{1FFFF}⚡🎯⚔️🎨🏆💫🎁🔥✨🏅💎🌑👀⏳🎲🖌️🎭]/u.test(l);
      if (hasEmoji && count < 5) { choices.push({ num: String(count + 1), text: l }); count++; }
    }
  }
  return choices;
}

function buildAccrocheCTASelectionUI(agentId, output) {
  const p = pfx();
  const accroches = parseChoices(output, 'A');
  const ctas = parseChoices(output, 'C');
  if (accroches.length > 0) {
    const z = document.getElementById(`${p}-sel-accroche-${agentId}`);
    const l = document.getElementById(`${p}-sel-list-accroche-${agentId}`);
    if (z && l) {
      z.classList.add('visible');
      l.innerHTML = accroches.map(a => `<div class="choice-item" onclick="selectChoice('accroche','${agentId}','${a.num}',this)"><input type="radio" name="acc-${agentId}"/><label>${a.text}</label></div>`).join('');
    }
  }
  if (ctas.length > 0) {
    const z = document.getElementById(`${p}-sel-cta-${agentId}`);
    const l = document.getElementById(`${p}-sel-list-cta-${agentId}`);
    if (z && l) {
      z.classList.add('visible');
      l.innerHTML = ctas.map(c => `<div class="choice-item" onclick="selectChoice('cta','${agentId}','${c.num}',this)"><input type="radio" name="cta-${agentId}"/><label>${c.text}</label></div>`).join('');
    }
  }
}

function selectChoice(type, agentId, num, el) {
  el.parentElement.querySelectorAll('.choice-item').forEach(x => x.classList.remove('selected'));
  el.classList.add('selected');
  el.querySelector('input').checked = true;
  const text = el.querySelector('label').textContent.trim();
  if (type === 'accroche') state.selectedAccroche = { num, text };
  if (type === 'cta') state.selectedCTA = { num, text };
}

function validateAccrocheCTA(agentId) {
  const p = pfx();
  if (!state.selectedAccroche || !state.selectedCTA) { alert('Choisis une accroche et un CTA.'); return; }
  const output = state.outputs[agentId];
  const lines = output.split('\n');
  const result = [];
  let accrocheDone = false, ctaDone = false;
  for (const l of lines) {
    if (l.match(/^A\d+\s*[→:]/)) { if (!accrocheDone) { result.push(state.selectedAccroche.text); accrocheDone = true; } continue; }
    if (l.match(/^C\d+\s*[→:]/)) { if (!ctaDone) { result.push(state.selectedCTA.text); ctaDone = true; } continue; }
    result.push(l);
  }
  state.outputs[`${agentId}_assembled`] = result.join('\n').trim();
  document.getElementById(`${p}-sel-accroche-${agentId}`).classList.remove('visible');
  document.getElementById(`${p}-sel-cta-${agentId}`).classList.remove('visible');
  document.getElementById(`${p}-stat-${agentId}`).textContent = '✓ sélection validée';
  document.getElementById(`${p}-stat-${agentId}`).className = 'agent-status s-done';
  const idx = getPipelineAgents().findIndex(a => a.id === agentId);
  (async () => {
    for (let i = idx + 1; i < getPipelineAgents().length; i++) {
      if (getPipelineAgents()[i].optional) break;
      const ok = await runAgent(getPipelineAgents()[i]);
      if (!ok) break;
    }
    assembleFinal();
  })();
}

